{
  "name": "Lulu Print Job Status Changed",
  "key": "lulu_print_job_status_changed",
  "shortDescription": "Fires whenever a Lulu print job changes status.",
  "summary": "Sends the Lulu lifecycle status, originating GHL Global Product, contact, and shipment data into a workflow. Use the Status filter to select one or more lifecycle states.",
  "subscriptionUrl": "https://YOUR_BACKEND_DOMAIN/workflow-trigger/subscription",
  "subscriptionHeaders": {
    "X-LiteraryApp-Trigger-Secret": "YOUR_GHL_TRIGGER_SUBSCRIPTION_SECRET"
  },
  "sampleData": {
    "event": "LULU_PRINT_JOB_STATUS_CHANGED",
    "triggerKey": "lulu_print_job_status_changed",
    "status": "IN_PRODUCTION",
    "statusChangedAt": "2026-08-21T12:34:56.000Z",
    "locationId": "ghl_location_id",
    "contactId": "ghl_contact_id",
    "contactName": "Jane Doe",
    "email": "jane@example.com",
    "phone": "+1 202-555-0147",
    "firstName": "Jane",
    "lastName": "Doe",
    "trackingId": null,
    "trackingIds": [],
    "trackingUrl": null,
    "trackingUrls": [],
    "carrierName": null,
    "carrierNames": [],
    "luluPrintJobId": "42776",
    "internalPrintJobId": "local-print-job-uuid",
    "bookTitle": "Example Book",
    "ghlProductId": "highlevel-global-product-id",
    "quantity": 1,
    "shippingLevel": "MAIL"
  },
  "filters": [
    {
      "name": "Status",
      "reference": "status",
      "type": "multiselect",
      "required": true,
      "optionType": "constants",
      "options": [
        { "label": "Created", "value": "CREATED" },
        { "label": "Unpaid", "value": "UNPAID" },
        { "label": "Payment in Progress", "value": "PAYMENT_IN_PROGRESS" },
        { "label": "Production Delayed", "value": "PRODUCTION_DELAYED" },
        { "label": "Production Ready", "value": "PRODUCTION_READY" },
        { "label": "In Production", "value": "IN_PRODUCTION" },
        { "label": "Shipped", "value": "SHIPPED" },
        { "label": "Delivered", "value": "DELIVERED" },
        { "label": "Rejected", "value": "REJECTED" },
        { "label": "Canceled", "value": "CANCELED" },
        { "label": "Error", "value": "ERROR" }
      ]
    },
    {
      "name": "Global Product",
      "reference": "ghlProductId",
      "type": "select",
      "required": true,
      "optionType": "internal_reference",
      "module": "Global Products"
    }
  ],
  "customVariables": [
    { "label": "Contact ID", "reference": "contactId", "type": "string" },
    { "label": "Contact Name", "reference": "contactName", "type": "string" },
    { "label": "Email", "reference": "email", "type": "string" },
    { "label": "Phone", "reference": "phone", "type": "string" },
    { "label": "First Name", "reference": "firstName", "type": "string" },
    { "label": "Last Name", "reference": "lastName", "type": "string" },
    { "label": "Tracking ID", "reference": "trackingId", "type": "string" },
    { "label": "Tracking URL", "reference": "trackingUrl", "type": "string" },
    { "label": "Carrier", "reference": "carrierName", "type": "string" },
    { "label": "Lulu Print Job ID", "reference": "luluPrintJobId", "type": "string" },
    { "label": "Internal Print Job ID", "reference": "internalPrintJobId", "type": "string" },
    { "label": "Book Title", "reference": "bookTitle", "type": "string" },
    { "label": "Global Product ID", "reference": "ghlProductId", "type": "string" },
    { "label": "Quantity", "reference": "quantity", "type": "string" },
    { "label": "Shipping Level", "reference": "shippingLevel", "type": "string" },
    { "label": "Status", "reference": "status", "type": "string" },
    { "label": "Status Changed At", "reference": "statusChangedAt", "type": "string" },
    { "label": "Location ID", "reference": "locationId", "type": "string" }
  ]
}
